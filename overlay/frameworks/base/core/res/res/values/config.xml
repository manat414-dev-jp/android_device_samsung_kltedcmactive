<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Galaxy S5 Active has mechanical hardware buttons (Home, Back, Recent/Menu) and Active Key -->
    <bool name="config_showNavigationBar">false</bool>
    <integer name="config_deviceHardwareKeys">67</integer> <!-- 1 (Menu) + 2 (Home) + 64 (AppSwitch) -->

    <!-- Default screen brightness (0-255) -->
    <integer name="config_screenBrightnessSettingDefault">128</integer>

    <!-- Support doze / ambient display -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">false</bool>

    <!-- Wi-Fi configuration -->
    <bool name="config_wifi_dual_band_support">true</bool>
    <bool name="config_wifi_p2p_support">true</bool>

    <!-- Auto power modes -->
    <bool name="config_automatic_brightness_available">true</bool>
</resources>
