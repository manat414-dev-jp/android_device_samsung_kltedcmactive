#
# Key layout for Samsung Galaxy S5 Active (SC-02G / kltedcmactive)
#

key 115   VOLUME_UP
key 114   VOLUME_DOWN
key 116   POWER
key 172   HOME
key 158   BACK
key 254   APP_SWITCH
key 139   MENU
key 528   FOCUS
key 252   CAMERA
key 766   CAMERA

# Active Key (GPIO 144 / HOT_KEY)
key 144   BUTTON_1
