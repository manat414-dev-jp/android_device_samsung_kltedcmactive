#
# Galaxy S5 Active (SC-02G / kltedcmactive) GPIO Keylayout
#

# Power & Volume
key 116   POWER             WAKE
key 115   VOLUME_UP         WAKE
key 114   VOLUME_DOWN       WAKE

# Physical Front Hardware Buttons (S5 Active has mechanical click buttons!)
key 172   HOME              WAKE
key 158   BACK
key 139   MENU
key 580   APP_SWITCH

# Dedicated Side Orange "Active Key" (Short press & Long press)
# Linux event 249 -> APP_SWITCH or customizable FAVORITES key
key 249   APP_SWITCH        WAKE
# Alternate mapping options:
# key 249   EXPLORER          WAKE
# key 249   CAMERA            WAKE
